# Copy to .env.production (and .env.development.local for `npm run dev`).
# Values come from the outputs of the composytex-admin SAM stack; none of them are secret.
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=us-east-1

# Development only: show images uploaded to S3 while running locally.
# VITE_MEDIA_BASE=https://composytex.com
